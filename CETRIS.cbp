<?xml version="1.0" encoding="UTF-8"?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="CETRIS" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Debug">
                <Option output="bin/Debug/CETRIS" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Debug/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Option working_dir="$(PROJECT_DIR)" />
                <Compiler>
                    <Add option="-g" />
                    <Add option="-std=c99" />
                    <Add option="-Wall" />
                    <Add option="-Wextra" />
                </Compiler>
            </Target>
            <Target title="Release">
                <Option output="bin/Release/CETRIS" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Release/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Option working_dir="$(PROJECT_DIR)" />
                <Compiler>
                    <Add option="-O2" />
                    <Add option="-std=c99" />
                    <Add option="-Wall" />
                    <Add option="-Wextra" />
                </Compiler>
                <Linker>
                    <Add option="-s" />
                </Linker>
            </Target>
        </Build>
        <Compiler>
            <Add option="-Wall" />
            <Add option="-Wextra" />
        </Compiler>
        <Unit filename="src/cetris.c">
            <Option compilerVar="CC" />
        </Unit>
        <Extensions>
            <code_completion />
            <envvars />
        </Extensions>
    </Project>
</CodeBlocks_project_file>
